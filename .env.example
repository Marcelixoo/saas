# -----------------------------------------------------------------------------
# Local developer environment template. Copy to .env and fill in as needed.
# `docker compose up --build` (or `docker compose --profile full up --build`
# once apps/control-plane and apps/web Dockerfiles land) reads these values.
# See CONTRACT.md for the full cross-service contract.
# -----------------------------------------------------------------------------

# ---- Postgres (control-plane datastore) ------------------------------------
POSTGRES_USER=saas
POSTGRES_PASSWORD=saas
POSTGRES_DB=saas
# Full connection string used by control-plane (Prisma). Host is the compose
# service name; from the host machine use localhost:5432 instead.
DATABASE_URL=postgresql://saas:saas@postgres:5432/saas

# ---- Redis (control-plane quota/rate-limit store) ---------------------------
REDIS_URL=redis://redis:6379

# ---- Meilisearch (internal search engine) -----------------------------------
MEILISEARCH_HOST=http://meilisearch:7700
# Optional - required for production Meilisearch instances
MEILISEARCH_API_KEY=
# Optional locally; set to enable Meilisearch auth
MEILI_MASTER_KEY=

# ---- Go search-api (internal only, never exposed publicly) -----------------
SERVER_PORT=8081
SEARCH_API_URL=http://search-api:8081
DATABASE_PATH=file:articles.db?cache=shared&mode=memory
SEARCH_RATE_LIMIT=60

# ---- Fastify control-plane (public) -----------------------------------------
PORT=8080
JWT_SECRET=dev-only-change-me
# Comma-separated list of full emails and/or "@domain" entries allowed to
# self-register. Includes an @e2e.test entry so the acceptance suite can
# generate unique allow-listed emails per run via plus-addressing
# (e.g. assessor+<runid>@e2e.test). Case-insensitive.
ALLOWED_SIGNUP_EMAILS=@e2e.test
FREE_SEARCH_LIMIT=30
PRO_SEARCH_LIMIT=300

# ---- Legacy JWT config consumed by the Go service ---------------------------
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_ISSUER=fashion-catalog
JWT_ACCESS_TTL=24h
JWT_REFRESH_TTL=168h

# ---- Next.js web (public) ----------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080

# ---- GCP Configuration (for deployment, not needed for local dev) ----------
GCP_SA_KEY=
GCP_PROJECT_ID=criticalmars-saas
