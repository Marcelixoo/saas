# Control plane (Fastify) configuration.
# Copy to .env for local development. Do NOT commit a real .env file.

PORT=8080
HOST=0.0.0.0

# PostgreSQL connection string (Prisma).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/control_plane

# Redis connection string, used for organization-scoped rate limiting.
REDIS_URL=redis://localhost:6379

# Secret used to sign/verify JWTs. Use a long random value in real environments.
JWT_SECRET=change-me-in-production

# Base URL of the internal Go search API. Never exposed publicly.
SEARCH_API_URL=http://search-api:8081

# Per-plan search rate limits (requests per minute), organization-scoped.
FREE_SEARCH_LIMIT=30
PRO_SEARCH_LIMIT=300

# Comma-separated signup allowlist. Entries are either a full email
# (alice@corp.com) or an "@domain" entry (@e2e.test) matching any local-part
# at that domain. Matching is case-insensitive.
ALLOWED_SIGNUP_EMAILS=alice@corp.com,@e2e.test
